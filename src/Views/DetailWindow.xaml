<Window x:Class="SystemSpinnerX64.Views.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SystemSpinnerX64.Views"
        Title="System Spinner x64"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Width="440"
        Height="430"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Border x:Name="Shell" CornerRadius="14" BorderThickness="1" Padding="18,16,18,14">
        <DockPanel x:Name="Body" LastChildFill="True">

            <TextBlock x:Name="Caption"
                       DockPanel.Dock="Top"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />

            <!-- The chart with the scale labels on the right. The scale is fixed from zero to a
                 hundred: without it a quiet hour would look like peak load. -->
            <Grid DockPanel.Dock="Top" Height="120" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <views:SparklineControl x:Name="Chart" Grid.Column="0" />

                <Grid Grid.Column="1" Margin="6,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="Axis100" Grid.Row="0" Text="100" FontSize="11" VerticalAlignment="Top" />
                    <TextBlock x:Name="Axis75"  Grid.Row="1" Text="75"  FontSize="11" VerticalAlignment="Top" />
                    <TextBlock x:Name="Axis50"  Grid.Row="2" Text="50"  FontSize="11" VerticalAlignment="Top" />
                    <TextBlock x:Name="Axis25"  Grid.Row="3" Text="25"  FontSize="11" VerticalAlignment="Top" />
                    <TextBlock x:Name="Axis0"   Grid.Row="4" Text="0"   FontSize="11" VerticalAlignment="Top" />
                </Grid>
            </Grid>

            <!-- The table header. It does not scroll with the list: half way down there would
                 otherwise be no telling what the number on the right means. -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="HeadPid" Grid.Column="0" FontWeight="SemiBold" FontSize="12" />
                <TextBlock x:Name="HeadName" Grid.Column="1" FontWeight="SemiBold" FontSize="12" Margin="24,0,0,0" />
                <TextBlock x:Name="HeadUsage" Grid.Column="2" FontWeight="SemiBold" FontSize="12" />
            </Grid>

            <!-- No scrollbar but scrolling still works: the list is short, and the bar would eat
                 a dozen pixels of width and be visible longer than it is needed. The wheel is
                 enough here. -->
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Processes">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Pid}"
                                           FontSize="12"
                                           Opacity="0.6"
                                           FontFamily="Consolas, Cascadia Mono, Courier New"
                                           VerticalAlignment="Center" />

                                <Image Grid.Column="1"
                                       Source="{Binding Icon}"
                                       Width="16" Height="16"
                                       VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Name}"
                                           FontSize="12"
                                           Margin="6,0,8,0"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="3"
                                           Text="{Binding Usage}"
                                           FontSize="12"
                                           FontFamily="Consolas, Cascadia Mono, Courier New"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
