<Window x:Class="SystemSpinnerX64.Osd.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System-Spinner x64 OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False"
        SizeToContent="Manual"
        Width="300"
        Height="72"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Border x:Name="Pill"
            CornerRadius="12"
            BorderThickness="1">

        <Grid Margin="22,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="Glyph"
                       Grid.Column="0"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="24"
                       Margin="0,0,16,0"
                       Width="30"
                       TextAlignment="Center"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                <Grid Height="4">
                    <Border x:Name="BarTrack" CornerRadius="2" />
                    <Border x:Name="BarFill"
                            CornerRadius="2"
                            HorizontalAlignment="Left"
                            Width="0" />
                </Grid>

                <Canvas x:Name="Scale" Height="7" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
