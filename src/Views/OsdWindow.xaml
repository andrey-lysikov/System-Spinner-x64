<Window x:Class="SystemSpinnerX64.Osd.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System-Spinner OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False"
        SizeToContent="Manual"
        Width="300"
        Height="72"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <!-- The same shape as the status window rather than a pill: two popups of one program should
         not look like they came from different ones. The background is set in code — when the
         system grants an acrylic backdrop this stays a near-transparent film and Windows does the
         blurring; when it does not, a solid colour goes here or the bar drowns in the wallpaper. -->
    <Border x:Name="Pill"
            CornerRadius="12"
            BorderThickness="1">

        <Grid Margin="22,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- A glyph from the system font: the app ships no pictures of its own, and this
                 set is present in every Windows 11 and follows the theme. -->
            <TextBlock x:Name="Glyph"
                       Grid.Column="0"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="24"
                       Margin="0,0,16,0"
                       Width="30"
                       TextAlignment="Center"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                <!-- The filled part is drawn over the empty one rather than stretching it: the
                     bar has rounded ends, and clipping by width looks cleaner. -->
                <Grid Height="4">
                    <Border x:Name="BarTrack" CornerRadius="2" />
                    <Border x:Name="BarFill"
                            CornerRadius="2"
                            HorizontalAlignment="Left"
                            Width="0" />
                </Grid>

                <!-- Ticks: they show how large the adjustment step is. Exactly the hint the step
                     count setting was introduced for in the macOS version. -->
                <Canvas x:Name="Scale" Height="7" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
