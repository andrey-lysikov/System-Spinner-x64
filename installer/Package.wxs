<?xml version="1.0" encoding="utf-8"?>

<!-- Per-user (default) or per-machine install; per-user copies are independent per Windows user.
     Updates touch only our own or the per-machine copy. Built by installer/installer.ps1. -->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- perUserOrMachine: a per-user install is registered under that user alone, so another user
       neither sees it nor upgrades it, and two users can keep two different versions. -->
  <Package Name="System Spinner x64"
           Manufacturer="$(Manufacturer)"
           Version="$(Version)"
           UpgradeCode="D993C858-1615-4986-B456-173BEFEDA37C"
           Scope="perUserOrMachine"
           Compressed="yes">

    <!-- One cab inside the msi. Compressed hard: most of what goes in is the PawnIO setup. -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Same version too, or a rebuild of that number would leave both installed. Which copy is
         upgraded is decided below, before FindRelatedProducts, by choosing the context it looks in. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of System Spinner x64 is already installed." />

    <!-- The floor the app stands on, the same one PlatformGuard.cs checks at run time. From the
         registry: WindowsBuild and VersionNT lie to an msi (9600 and 603 on build 28000). -->
    <Property Id="WINDOWSBUILDNUMBER">
      <RegistrySearch Id="WindowsBuildSearch"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber"
                      Type="raw"
                      Bitness="always64" />
    </Property>

    <Launch Condition="VersionNT64 AND WINDOWSBUILDNUMBER &gt;= 22000"
            Message="System Spinner x64 needs 64-bit Windows 11 or newer. This machine does not meet that, and nothing has been installed." />

    <Icon Id="AppIcon.ico" SourceFile="$(Icon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/andrey-lysikov/System-Spinner-x64" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- What the scope and folder pages stand on: the profile of the person installing first. -->
    <Property Id="ApplicationFolderName" Value="System-Spinner" />
    <Property Id="WixAppFolder" Value="WixPerUserFolder" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="APPLICATIONFOLDER" Name="System-Spinner" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="TempFolder" />

    <!-- "Just me" would land in AppData\Local\Apps\System-Spinner, one folder deeper than the
         config and log the app keeps in AppData\Local\System-Spinner. -->
    <SetProperty Id="WixPerUserFolder"
                 Value="[LocalAppDataFolder]System-Spinner"
                 After="WixSetDefaultPerUserFolder"
                 Sequence="both" />

    <!-- And "for everyone" would land in Program Files (x86): ProgramFilesFolder means the
         32-bit one even in a 64-bit package. This app is x64. -->
    <SetProperty Id="WixPerMachineFolder"
                 Value="[ProgramFiles64Folder]System-Spinner"
                 After="WixSetDefaultPerMachineFolder"
                 Sequence="both" />

    <!-- ===== Which copy is already here, and whose ===== -->

    <!-- A copy of this user's own: every per-user install of this version on leaves its folder in
         HKCU (the InstallMark component). Nobody else's HKCU is ever read. -->
    <Property Id="USERCOPYFOLDER" Secure="yes">
      <RegistrySearch Id="UserCopySearch"
                      Root="HKCU"
                      Key="Software\System-Spinner"
                      Name="InstallFolder"
                      Type="raw" />
    </Property>

    <!-- Registered exe: this user's per-user copy, else a per-machine one
         (up to 1.3 every install was per-machine, even in a profile). -->
    <!-- Type="file", which gives the folder the file is in: the key path is a file, and "directory"
         looks for a folder of that name and finds nothing, as it did up to 1.3. -->
    <Property Id="INSTALLEDFOLDER" Secure="yes">
      <ComponentSearch Id="InstalledAppSearch"
                       Guid="0F8D272E-1348-400B-A2CF-93B2527E70DF" Type="file" />
    </Property>

    <!-- Unregistered exe in this user's profile (manual or broken install).
         Program Files is not searched: it may hold another user's copy. -->
    <Property Id="PERUSERCOPY" Secure="yes">
      <DirectorySearch Id="PerUserFolderSearch" Path="[LocalAppDataFolder]System-Spinner">
        <FileSearch Id="PerUserExeSearch" Name="System-Spinner.exe" />
      </DirectorySearch>
    </Property>

    <!-- A per-machine copy of 1.3 or earlier records no owner;
         only its location tells: this profile, another profile, or elsewhere. -->

    <!-- This user's profile, as the logon wrote it: HKCU\Volatile Environment is filled in for the
         account that signed in, whatever folder its profile ended up in. -->
    <Property Id="OWNPROFILE">
      <RegistrySearch Id="OwnProfileSearch"
                      Root="HKCU"
                      Key="Volatile Environment"
                      Name="USERPROFILE"
                      Type="raw" />
    </Property>

    <!-- The folder all profiles are made in, from the same list Windows keeps of them. -->
    <Property Id="PROFILESFOLDER">
      <RegistrySearch Id="ProfilesFolderSearch"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileList"
                      Name="ProfilesDirectory"
                      Type="directory"
                      Bitness="always64" />
    </Property>

    <!-- With a backslash, or C:\Users\Bob would count C:\Users\Bobby as its own. -->
    <SetProperty Id="OWNPROFILEFOLDER"
                 Value="[OWNPROFILE]\"
                 After="AppSearch"
                 Sequence="both"
                 Condition="OWNPROFILE" />
    <SetProperty Id="PROFILESFOLDER"
                 Action="SetDefaultProfilesFolder"
                 Value="[WindowsVolume]Users\"
                 After="SetOWNPROFILEFOLDER"
                 Sequence="both"
                 Condition="NOT PROFILESFOLDER" />

    <!-- 1. This user's own per-user copy wins over everything. -->
    <SetProperty Action="SetOwnCopyFolder"
                 Id="COPYFOLDER"
                 Value="[USERCOPYFOLDER]"
                 After="SetDefaultProfilesFolder"
                 Sequence="both"
                 Condition="NOT Installed AND USERCOPYFOLDER" />
    <SetProperty Action="SetOwnCopyPerUser"
                 Id="COPYPERUSER"
                 Value="1"
                 After="SetOwnCopyFolder"
                 Sequence="both"
                 Condition="NOT Installed AND USERCOPYFOLDER" />

    <!-- 2. Old per-machine copy in another user's profile: left alone, install per-user beside it.
         LocalAppData is checked too, for accounts without Volatile Environment. -->
    <SetProperty Action="SetOtherUserCopy"
                 Id="OTHERUSERCOPY"
                 Value="1"
                 After="SetOwnCopyPerUser"
                 Sequence="both"
                 Condition="NOT Installed AND NOT USERCOPYFOLDER AND INSTALLEDFOLDER AND (INSTALLEDFOLDER ~&lt;&lt; PROFILESFOLDER) AND NOT (OWNPROFILEFOLDER AND INSTALLEDFOLDER ~&lt;&lt; OWNPROFILEFOLDER) AND NOT (INSTALLEDFOLDER ~&lt;&lt; LocalAppDataFolder)" />

    <!-- 3. Any other per-machine copy: for everyone, or this user's own from 1.3 or earlier. It is
         updated where it is and stays per-machine, since one context cannot upgrade the other. -->
    <SetProperty Action="SetMachineCopyFolder"
                 Id="COPYFOLDER"
                 Value="[INSTALLEDFOLDER]"
                 After="SetOtherUserCopy"
                 Sequence="both"
                 Condition="NOT Installed AND NOT USERCOPYFOLDER AND INSTALLEDFOLDER AND NOT OTHERUSERCOPY" />

    <!-- 4. An unregistered exe in this user's profile: installed over, per-user. -->
    <SetProperty Action="SetLooseCopyPerUser"
                 Id="COPYPERUSER"
                 Value="1"
                 After="SetMachineCopyFolder"
                 Sequence="both"
                 Condition="NOT Installed AND COPYFOLDER = &quot;&quot; AND PERUSERCOPY" />
    <SetProperty Action="SetLooseCopyFolder"
                 Id="COPYFOLDER"
                 Value="[LocalAppDataFolder]System-Spinner\"
                 After="SetLooseCopyPerUser"
                 Sequence="both"
                 Condition="NOT Installed AND COPYFOLDER = &quot;&quot; AND PERUSERCOPY" />

    <!-- Everything that follows turns on this. Both sequences: the dialogs and the install itself
         run in different processes, and each has to know. -->
    <SetProperty Action="SetUpdateMode"
                 Id="UPDATEMODE"
                 Value="1"
                 After="SetLooseCopyFolder"
                 Sequence="both"
                 Condition="NOT Installed AND COPYFOLDER" />

    <!-- Context set before FindRelatedProducts, which searches only that context. Updates keep
         their copy's context; next to another user's old copy only per-user, so it isn't removed. -->
    <SetProperty Action="SetPerUserScope"
                 Id="ALLUSERS"
                 Value="{}"
                 After="SetUpdateMode"
                 Sequence="both"
                 Condition="NOT Installed AND (COPYPERUSER OR OTHERUSERCOPY)" />
    <SetProperty Action="SetPerMachineScope"
                 Id="ALLUSERS"
                 Value="1"
                 After="SetPerUserScope"
                 Sequence="both"
                 Condition="UPDATEMODE AND NOT COPYPERUSER" />

    <!-- An update stays where it already is rather than moving out from under its own shortcuts.
         Naming the folder also stands the stock actions at 998 and 999 down. -->
    <SetProperty Id="APPLICATIONFOLDER"
                 Value="[COPYFOLDER]"
                 After="SetPerMachineScope"
                 Sequence="both"
                 Condition="UPDATEMODE" />

    <InstallUISequence>
      <FindRelatedProducts After="SetAPPLICATIONFOLDER" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <FindRelatedProducts After="SetAPPLICATIONFOLDER" />
    </InstallExecuteSequence>

    <!-- A first install goes to the profile unless the scope page says otherwise: the stock actions
         would pick Program Files for anyone Privileged, which an administrator is even unelevated. -->
    <SetProperty Id="APPLICATIONFOLDER"
                 Action="SetDefaultApplicationFolder"
                 Value="[WixPerUserFolder]"
                 After="SetWixPerMachineFolder"
                 Sequence="both"
                 Condition="NOT Installed AND APPLICATIONFOLDER = &quot;&quot;" />

    <!-- Named after the exe rather than the project: a menu entry calling itself something else
         is one more thing to match up when looking for what is running. -->
    <?define ShortcutName = "System-Spinner" ?>
    <?define ShortcutNote = "System monitoring in the tray and over full-screen applications" ?>

    <ComponentGroup Id="AppFiles" Directory="APPLICATIONFOLDER">
      <Component Id="MainExe" Guid="0F8D272E-1348-400B-A2CF-93B2527E70DF">
        <File Id="SystemSpinnerExe" Source="$(Exe)" Name="System-Spinner.exe" KeyPath="yes" />
      </Component>

      <!-- Where this copy is. HKMU: HKCU for a per-user install, which is what USERCOPYFOLDER reads,
           and HKLM for one for everyone, where nothing reads it but it does no harm. -->
      <Component Id="InstallMark" Guid="AC0500F3-7732-406C-B7EA-5343B8BC8D50">
        <RegistryValue Root="HKMU"
                       Key="Software\System-Spinner"
                       Name="InstallFolder"
                       Type="string"
                       Value="[APPLICATIONFOLDER]"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- PawnIO, carried rather than fetched: the app will not start without it. In the temporary
         folder, since it is of use once and the app folder is no place to keep it for ever. -->
    <ComponentGroup Id="DriverFiles" Directory="TempFolder">
      <!-- A new GUID, not the one of the program that used to sit here: a component keeps its
           key path for as long as its GUID lives, and this one holds a different file. -->
      <Component Id="PawnIoSetup" Guid="60735EC3-FDCF-4933-B90F-95A1AD28DB3C">
        <File Id="PawnIoSetupExe" Source="$(PawnIO)" Name="PawnIO_setup.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Shortcuts directly in the menu, not advertised (no icon, no repair machinery).
         User's own menu/desktop for per-user, shared ones otherwise. -->
    <ComponentGroup Id="StartMenuShortcutFiles" Directory="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="C0D8CE73-8C33-4E5C-9A24-7C5A03FFB1CE">
        <Shortcut Id="StartMenuShortcutEntry"
                  Name="$(ShortcutName)"
                  Description="$(ShortcutNote)"
                  Target="[APPLICATIONFOLDER]System-Spinner.exe"
                  WorkingDirectory="APPLICATIONFOLDER"
                  Icon="AppIcon.ico" />

        <!-- A shortcut cannot be a key path, so the mark of the component lives in the registry,
             under the user who asked for it. -->
        <RegistryValue Root="HKCU"
                       Key="Software\System-Spinner"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="DesktopShortcutFiles" Directory="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="395728B0-E5F2-4C43-AB40-1EE36C820CC9">
        <Shortcut Id="DesktopShortcutEntry"
                  Name="$(ShortcutName)"
                  Description="$(ShortcutNote)"
                  Target="[APPLICATIONFOLDER]System-Spinner.exe"
                  WorkingDirectory="APPLICATIONFOLDER"
                  Icon="AppIcon.ico" />

        <RegistryValue Root="HKCU"
                       Key="Software\System-Spinner"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- On by default; a feature each, so an omitted one is remembered at removal.
         Updates carry them over via MigrateFeatureStates. -->
    <Property Id="INSTALLSTARTMENUSHORTCUT" Value="1" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />

    <Feature Id="Main"
             Title="System Spinner x64"
             Description="The application itself."
             Level="1"
             AllowAbsent="no"
             ConfigurableDirectory="APPLICATIONFOLDER">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="DriverFiles" />

      <Feature Id="StartMenu" Title="Start menu shortcut"
               Description="A shortcut in the Start menu." Level="1">
        <ComponentGroupRef Id="StartMenuShortcutFiles" />
        <Level Value="0" Condition="NOT UPDATEMODE AND INSTALLSTARTMENUSHORTCUT &lt;&gt; 1" />
      </Feature>

      <Feature Id="Desktop" Title="Desktop shortcut"
               Description="A shortcut on the desktop." Level="1">
        <ComponentGroupRef Id="DesktopShortcutFiles" />
        <Level Value="0" Condition="NOT UPDATEMODE AND INSTALLDESKTOPSHORTCUT &lt;&gt; 1" />
      </Feature>
    </Feature>

    <!-- A way out for a deployment that manages the driver itself: msiexec /i ... INSTALLPAWNIO=0
         The app will say what is missing at its first start. -->
    <Property Id="INSTALLPAWNIO" Value="1" Secure="yes" />

    <!-- Deferred, not impersonated: runs silently as SYSTEM, so per-user installs elevate at Install
         (RelaunchAtExecute). FileRef because deferred actions read no properties. -->
    <CustomAction Id="InstallPawnIo"
                  FileRef="PawnIoSetupExe"
                  ExeCommand="-install -silent"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- ===== The running app and its autostart: only what belongs to this copy ===== -->

    <!-- Closes only this copy's processes (WM_CLOSE via taskkill, then force); no brackets/braces.
         Immediate, before InstallValidate: deferred fails with 2613. -->
    <SetProperty Action="SetStopRunningApp"
                 Id="WixQuietExecCmdLine"
                 Sequence="execute"
                 Before="StopRunningApp"
                 Condition="UPDATEMODE AND NOT REMOVE~=&quot;ALL&quot;"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$p = @(Get-Process -Name System-Spinner -ErrorAction SilentlyContinue | Where-Object Path -Like \&quot;[APPLICATIONFOLDER]*\&quot;); taskkill.exe (-split ($p.Id -replace '^', '/pid ')) 2&gt;$null | Out-Null; $p | Wait-Process -Timeout 5 -ErrorAction SilentlyContinue; $p | Stop-Process -Force -ErrorAction SilentlyContinue; $p | Wait-Process -Timeout 15 -ErrorAction SilentlyContinue; exit 0&quot;" />
    <CustomAction Id="StopRunningApp"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_X64"
                  Execute="immediate"
                  Return="ignore" />

    <!-- Uninstall: deferred as SYSTEM to end the elevated app. A per-user removal from Settings
         runs unelevated, so the app stays until the requested restart. -->
    <SetProperty Id="StopAppForRemoval"
                 Sequence="execute"
                 Before="StopAppForRemoval"
                 Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$p = @(Get-Process -Name System-Spinner -ErrorAction SilentlyContinue | Where-Object Path -Like \&quot;[APPLICATIONFOLDER]*\&quot;); taskkill.exe (-split ($p.Id -replace '^', '/pid ')) 2&gt;$null | Out-Null; $p | Wait-Process -Timeout 5 -ErrorAction SilentlyContinue; $p | Stop-Process -Force -ErrorAction SilentlyContinue; $p | Wait-Process -Timeout 15 -ErrorAction SilentlyContinue; exit 0&quot;" />
    <CustomAction Id="StopAppForRemoval"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_X64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Removes every autostart task (per-user, or legacy plain name) that starts this copy's exe.
         Filtered on task XML without braces; failures don't stop the uninstall. -->
    <SetProperty Id="RemoveAutostartTask"
                 Sequence="execute"
                 Before="RemoveAutostartTask"
                 Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$x = @(Get-ScheduledTask -TaskPath \ -TaskName System-Spinner* -ErrorAction SilentlyContinue | Export-ScheduledTask) -like \&quot;*[APPLICATIONFOLDER]System-Spinner.exe*\&quot;; $n = @($x -replace '(?s).*&lt;URI&gt;\\?(.*?)&lt;/URI&gt;.*', '$1'); $n.Count -and (Unregister-ScheduledTask -TaskPath \ -TaskName $n -Confirm:$false -ErrorAction SilentlyContinue) | Out-Null; exit 0&quot;" />
    <CustomAction Id="RemoveAutostartTask"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_X64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- After the files are on disk, since the setup being run is one of them. Every time:
           what to do with a copy it finds is PawnIO's own setup to decide. -->
      <Custom Action="InstallPawnIo" After="InstallFiles"
              Condition="NOT Installed AND INSTALLPAWNIO = 1" />

      <!-- Only on a real uninstall. An upgrade removes the old version with REMOVE=ALL as well,
           and UPGRADINGPRODUCTCODE is set on exactly that half and on nothing else. -->
      <Custom Action="StopAppForRemoval" Before="RemoveAutostartTask"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveAutostartTask" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />

      <Custom Action="StopRunningApp" Before="InstallValidate"
              Condition="UPDATEMODE AND NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <!-- ===== Administrator rights: when they are asked for ===== -->

    <!-- Relaunch this msi elevated; ELEVATED stops recursion, UILevel 5 skips /qn and /qb.
         Exit code inverted: 1 = elevated copy started (FatalError, hidden), 0 = UAC refused. -->

    <!-- Update: once, before its first page. Per-machine updates pass ALLUSERS=1,
         or the msi won't find itself installed and skip the maintenance pages. -->
    <SetProperty Id="RELAUNCHSCOPE"
                 Value="ALLUSERS=1"
                 Sequence="ui"
                 Before="SetRelaunchElevated"
                 Condition="UPDATEMODE AND NOT COPYPERUSER AND NOT ELEVATED AND UILevel = 5" />
    <SetProperty Id="ELEVATIONREQUESTED"
                 Value="1"
                 Sequence="ui"
                 Before="RelaunchElevated"
                 Condition="UPDATEMODE AND NOT ELEVATED AND UILevel = 5" />
    <SetProperty Action="SetRelaunchElevated"
                 Id="WixQuietExecCmdLine"
                 Sequence="ui"
                 Before="RelaunchElevated"
                 Condition="UPDATEMODE AND NOT ELEVATED AND UILevel = 5"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Start-Process -FilePath '[System64Folder]msiexec.exe' -Verb RunAs -ArgumentList '/i \&quot;[OriginalDatabase]\&quot; ELEVATED=1 [RELAUNCHSCOPE]' -ErrorAction SilentlyContinue; exit (0 + $?)&quot;" />
    <CustomAction Id="RelaunchElevated"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_X64"
                  Execute="immediate"
                  Return="check" />

    <!-- Install/removal from these pages: per-user needs rights for PawnIO and closing the app,
         so the elevated copy is started with all choices, straight to progress. -->
    <SetProperty Id="INSTALLRELAUNCH"
                 Value="1"
                 Sequence="ui"
                 After="UpdateDlg"
                 Condition="NOT ELEVATED AND UILevel = 5 AND NOT UPDATEMODE AND (NOT ALLUSERS OR (ALLUSERS = 2 AND MSIINSTALLPERUSER = 1)) AND ((NOT Installed AND &amp;Main = 3) OR (Installed AND &amp;Main = 2))" />

    <!-- Folder passed without its trailing backslash (it would escape the quote; | guards it).
         Double quotes throughout: a profile path may contain an apostrophe. -->
    <SetProperty Action="SetRelaunchInstall"
                 Id="WixQuietExecCmdLine"
                 Sequence="ui"
                 After="SetINSTALLRELAUNCH"
                 Condition="INSTALLRELAUNCH AND NOT Installed"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$f = \&quot;[APPLICATIONFOLDER]|\&quot;.TrimEnd('|').TrimEnd('\'); Start-Process -FilePath \&quot;[System64Folder]msiexec.exe\&quot; -Verb RunAs -ArgumentList \&quot;/i `\&quot;[OriginalDatabase]`\&quot; ELEVATED=1 PRESETINSTALL=1 ALLUSERS=`\&quot;[ALLUSERS]`\&quot; MSIINSTALLPERUSER=`\&quot;[MSIINSTALLPERUSER]`\&quot; APPLICATIONFOLDER=`\&quot;$f`\&quot; INSTALLSTARTMENUSHORTCUT=`\&quot;[INSTALLSTARTMENUSHORTCUT]`\&quot; INSTALLDESKTOPSHORTCUT=`\&quot;[INSTALLDESKTOPSHORTCUT]`\&quot; LAUNCHAFTERINSTALL=`\&quot;[LAUNCHAFTERINSTALL]`\&quot;\&quot; -ErrorAction SilentlyContinue; exit (0 + $?)&quot;" />

    <!-- The removal needs no pages of its own any more: the progress bar is enough. -->
    <SetProperty Action="SetRelaunchRemove"
                 Id="WixQuietExecCmdLine"
                 Sequence="ui"
                 After="SetRelaunchInstall"
                 Condition="INSTALLRELAUNCH AND Installed"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Start-Process -FilePath \&quot;[System64Folder]msiexec.exe\&quot; -Verb RunAs -ArgumentList \&quot;/x [ProductCode] /qb ELEVATED=1\&quot; -ErrorAction SilentlyContinue; exit (0 + $?)&quot;" />

    <SetProperty Action="SetLateElevationRequested"
                 Id="ELEVATIONREQUESTED"
                 Value="1"
                 Sequence="ui"
                 After="SetRelaunchRemove"
                 Condition="INSTALLRELAUNCH" />

    <CustomAction Id="RelaunchAtExecute"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_X64"
                  Execute="immediate"
                  Return="check" />

    <!-- Past the pages there is no room for one more: a message, and the run ends. -->
    <CustomAction Id="AdminRefused"
                  Error="Administrator rights are needed: [ProductName] runs with them, and so does its installer, which puts in the PawnIO driver and closes the running app. Windows was asked for those rights and they were not given, so nothing has been changed. Run the installer again and allow it to make changes." />

    <!-- ===== The Update page in place of the stock first pages ===== -->

    <!-- The update options page starts from what is there now, not from the first-install defaults. -->
    <SetProperty Id="UPDSTARTMENU"
                 Value="1"
                 Sequence="ui"
                 After="MigrateFeatureStates"
                 Condition="UPDATEMODE AND &amp;StartMenu = 3" />
    <SetProperty Id="UPDDESKTOP"
                 Value="1"
                 Sequence="ui"
                 After="SetUPDSTARTMENU"
                 Condition="UPDATEMODE AND &amp;Desktop = 3" />

    <!-- Stock first pages can't be overridden: Installed and PATCH hide them, then PATCH is cleared.
         PRESETINSTALL goes straight to progress. Never reference WelcomeDlg (pulls WixUI_Minimal). -->
    <SetProperty Action="HideWelcomeForUpdate"
                 Id="Installed"
                 Value="1"
                 Sequence="ui"
                 Before="AdvancedWelcomeEulaDlg"
                 Condition="(UPDATEMODE OR PRESETINSTALL) AND NOT Installed AND NOT ELEVATIONREQUESTED" />
    <SetProperty Action="HideMaintenanceForUpdate"
                 Id="PATCH"
                 Value="1"
                 Sequence="ui"
                 After="AdvancedWelcomeEulaDlg"
                 Condition="(UPDATEMODE OR PRESETINSTALL) AND NOT ELEVATIONREQUESTED" />
    <SetProperty Action="ClearInstalledForUpdate"
                 Id="Installed"
                 Value="{}"
                 Sequence="ui"
                 After="MaintenanceWelcomeDlg"
                 Condition="(UPDATEMODE OR PRESETINSTALL) AND NOT ELEVATIONREQUESTED" />
    <SetProperty Action="ClearPatchForUpdate"
                 Id="PATCH"
                 Value="{}"
                 Sequence="ui"
                 After="ClearInstalledForUpdate"
                 Condition="(UPDATEMODE OR PRESETINSTALL) AND NOT ELEVATIONREQUESTED" />

    <!-- Started from the elevated copy, the app needs no second prompt. After ExecuteAction.
         Own property: a checkbox property may be used on one page only. -->
    <Property Id="UPDLAUNCH" Value="1" />

    <SetProperty Action="SetUpdatedAppTarget"
                 Id="WixShellExecTarget"
                 Value="[#SystemSpinnerExe]"
                 Sequence="ui"
                 After="ExecuteAction"
                 Condition="UPDATEMODE AND ELEVATED AND UPDLAUNCH = 1" />

    <InstallUISequence>
      <Custom Action="RelaunchElevated" After="SetUPDDESKTOP"
              Condition="UPDATEMODE AND NOT ELEVATED AND UILevel = 5" />
      <Show Dialog="AdminNeededDlg" After="RelaunchElevated" Condition="ELEVATIONREQUESTED" />
      <Show Dialog="override UserExit" OnExit="cancel" Condition="NOT ELEVATIONREQUESTED" />
      <Show Dialog="override FatalError" OnExit="error" Condition="NOT ELEVATIONREQUESTED" />

      <Show Dialog="UpdateDlg" After="ClearPatchForUpdate"
            Condition="UPDATEMODE AND NOT Installed AND NOT ELEVATIONREQUESTED" />

      <Custom Action="RelaunchAtExecute" After="SetLateElevationRequested" Condition="INSTALLRELAUNCH" />
      <Custom Action="AdminRefused" After="RelaunchAtExecute" Condition="INSTALLRELAUNCH" />

      <Custom Action="LaunchApplication" After="SetUpdatedAppTarget"
              Condition="UPDATEMODE AND ELEVATED AND UPDLAUNCH = 1" />
    </InstallUISequence>

    <!-- The advanced set: the one that asks whom the install is for and brings the folder page. -->
    <ui:WixUI Id="WixUI_Advanced" />
    <WixVariable Id="WixUILicenseRtf" Value="$(License)" />

    <!-- Via the shell: an installer-started process never gets the UAC prompt (error 1631).
         Elevated copy: no prompt; per-machine pages are unelevated, so the app asks itself. -->
    <Property Id="LAUNCHAFTERINSTALL" Value="1" />

    <CustomAction Id="SetAppTarget" Property="WixShellExecTarget" Value="[#SystemSpinnerExe]" />
    <CustomAction Id="LaunchApplication" DllEntry="WixShellExec" BinaryRef="Wix4UtilCA_X64" Impersonate="yes" />

    <!-- Our shortcuts page, between the folder page and the last one. The tens in Ordering put
         ours after the stock jumps (one to seven); the later of two next-dialogs decides. -->
    <UI>
      <!-- The stock set skips the folder page for a per-user install; that half is claimed here. -->
      <Publish Dialog="InstallScopeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg"
               Condition="WixAppFolder = &quot;WixPerUserFolder&quot;" Order="10" />

      <!-- Beside another user's old copy there is no scope to choose (see SetPerUserScope), so
           "Advanced" goes straight to the folder, and back from there. -->
      <Publish Dialog="AdvancedWelcomeEulaDlg" Control="Advanced" Event="NewDialog" Value="InstallDirDlg"
               Condition="OTHERUSERCOPY" Order="10" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="AdvancedWelcomeEulaDlg"
               Condition="OTHERUSERCOPY" Order="10" />

      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Order="10" />
      <Publish Dialog="ShortcutsDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" />
      <Publish Dialog="ShortcutsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />

      <!-- Claimed only while installing: during maintenance the last page returns to the
           repair-or-remove page, and a page about shortcuts has nothing to say then. -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg"
               Condition="NOT Installed" Order="10" />

      <!-- Only after a fresh install: this page also ends repair/uninstall, and updates start the app.
           The stock closing event is at 999, so these run first. -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="SetAppTarget"
               Condition="LAUNCHAFTERINSTALL = 1 AND NOT Installed AND NOT UPDATEMODE" Order="1" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="LAUNCHAFTERINSTALL = 1 AND NOT Installed AND NOT UPDATEMODE" Order="2" />
    </UI>
  </Package>
</Wix>
