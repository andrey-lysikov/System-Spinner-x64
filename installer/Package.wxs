<?xml version="1.0" encoding="utf-8"?>

<!-- The installer: where the app goes (the installer's profile, offered first, or Program Files),
     which shortcuts to make, whether to start it. Built by installer/installer.ps1. -->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="System Spinner x64"
           Manufacturer="$(Manufacturer)"
           Version="$(Version)"
           UpgradeCode="D993C858-1615-4986-B456-173BEFEDA37C"
           Scope="perMachine"
           Compressed="yes">

    <!-- One cab inside the msi. Compressed hard: most of what goes in is the PawnIO setup. -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- This is the whole of "is it already here?": a copy under this upgrade code makes the run
         an update. Same version too, or a rebuild of that number would leave both installed. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of System Spinner x64 is already installed." />

    <!-- The floor the app stands on, the same one PlatformGuard.cs checks at run time. From the
         registry: WindowsBuild and VersionNT lie to an msi (9600 and 603 on build 28000). -->
    <Property Id="WINDOWSBUILDNUMBER">
      <RegistrySearch Id="WindowsBuildSearch"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber"
                      Type="raw"
                      Bitness="always64" />
    </Property>

    <Launch Condition="VersionNT64 AND WINDOWSBUILDNUMBER &gt;= 22000"
            Message="System Spinner x64 needs 64-bit Windows 11 or newer. This machine does not meet that, and nothing has been installed." />

    <Icon Id="AppIcon.ico" SourceFile="$(Icon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/andrey-lysikov/System-Spinner-x64" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- What the folder dialog stands on. Both choices are machine-wide installs; only the folder
         changes, and the profile of the person installing is offered first. -->
    <Property Id="ApplicationFolderName" Value="System-Spinner" />
    <Property Id="WixAppFolder" Value="WixPerUserFolder" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="APPLICATIONFOLDER" Name="System-Spinner" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="TempFolder" />

    <!-- Machine-wide even under /qn, where no dialog runs to put the flag back. ALLUSERS is
         public, so msiexec ALLUSERS="" would otherwise beat the Property table. -->
    <SetProperty Id="ALLUSERS" Value="1" Before="FindRelatedProducts" Sequence="both" />

    <!-- "Just me" would land in AppData\Local\Apps\System-Spinner, one folder deeper than the
         config and log the app keeps in AppData\Local\System-Spinner. -->
    <SetProperty Id="WixPerUserFolder"
                 Value="[LocalAppDataFolder]System-Spinner"
                 After="WixSetDefaultPerUserFolder"
                 Sequence="both" />

    <!-- And "for everyone" would land in Program Files (x86): ProgramFilesFolder means the
         32-bit one even in a 64-bit package. This app is x64. -->
    <SetProperty Id="WixPerMachineFolder"
                 Value="[ProgramFiles64Folder]System-Spinner"
                 After="WixSetDefaultPerMachineFolder"
                 Sequence="both" />

    <!-- Where the copy being updated is. Windows Installer says a related product exists but
         never where it put itself, so its own record of the component is what is asked. -->
    <Property Id="INSTALLEDFOLDER" Secure="yes">
      <ComponentSearch Id="InstalledAppSearch"
                       Guid="0F8D272E-1348-400B-A2CF-93B2527E70DF" Type="directory" />
    </Property>

    <!-- An update stays where it already is rather than moving out from under its own shortcuts.
         Naming the folder also stands the stock actions at 998 and 999 down. -->
    <SetProperty Id="APPLICATIONFOLDER"
                 Value="[INSTALLEDFOLDER]"
                 After="AppSearch"
                 Sequence="both"
                 Condition="NOT Installed AND WIX_UPGRADE_DETECTED AND INSTALLEDFOLDER" />

    <!-- Without this a first install always goes to Program Files: the stock actions read
         ALLUSERS, which is 1 in a perMachine package, and never WixAppFolder. -->
    <SetProperty Id="APPLICATIONFOLDER"
                 Action="SetDefaultApplicationFolder"
                 Value="[WixPerUserFolder]"
                 After="SetWixPerMachineFolder"
                 Sequence="both"
                 Condition="NOT Installed AND APPLICATIONFOLDER = &quot;&quot;" />

    <!-- Named after the exe rather than the project: a menu entry calling itself something else
         is one more thing to match up when looking for what is running. -->
    <?define ShortcutName = "System-Spinner" ?>
    <?define ShortcutNote = "System monitoring in the tray and over full-screen applications" ?>

    <ComponentGroup Id="AppFiles" Directory="APPLICATIONFOLDER">
      <Component Id="MainExe" Guid="0F8D272E-1348-400B-A2CF-93B2527E70DF">
        <File Id="SystemSpinnerExe" Source="$(Exe)" Name="System-Spinner.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- PawnIO, carried rather than fetched: the app will not start without it. In the temporary
         folder, since it is of use once and the app folder is no place to keep it for ever. -->
    <ComponentGroup Id="DriverFiles" Directory="TempFolder">
      <!-- A new GUID, not the one of the program that used to sit here: a component keeps its
           key path for as long as its GUID lives, and this one holds a different file. -->
      <Component Id="PawnIoSetup" Guid="60735EC3-FDCF-4933-B90F-95A1AD28DB3C">
        <File Id="PawnIoSetupExe" Source="$(PawnIO)" Name="PawnIO_setup.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Directly in the menu: one entry deserves no folder. Not advertised, which would show no
         icon unless one is named in the msi and drag the repair machinery in behind it. -->
    <ComponentGroup Id="StartMenuShortcutFiles" Directory="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="C0D8CE73-8C33-4E5C-9A24-7C5A03FFB1CE">
        <Shortcut Id="StartMenuShortcutEntry"
                  Name="$(ShortcutName)"
                  Description="$(ShortcutNote)"
                  Target="[APPLICATIONFOLDER]System-Spinner.exe"
                  WorkingDirectory="APPLICATIONFOLDER"
                  Icon="AppIcon.ico" />

        <!-- A shortcut cannot be a key path, so the mark of the component lives in the registry,
             under the user who asked for it. -->
        <RegistryValue Root="HKCU"
                       Key="Software\System-Spinner"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="DesktopShortcutFiles" Directory="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="395728B0-E5F2-4C43-AB40-1EE36C820CC9">
        <Shortcut Id="DesktopShortcutEntry"
                  Name="$(ShortcutName)"
                  Description="$(ShortcutNote)"
                  Target="[APPLICATIONFOLDER]System-Spinner.exe"
                  WorkingDirectory="APPLICATIONFOLDER"
                  Icon="AppIcon.ico" />

        <RegistryValue Root="HKCU"
                       Key="Software\System-Spinner"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- On by default, and a feature each rather than a condition on the component: a feature
         left out is remembered as left out, a condition would be asked again at removal. -->
    <Property Id="INSTALLSTARTMENUSHORTCUT" Value="1" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />

    <Feature Id="Main"
             Title="System Spinner x64"
             Description="The application itself."
             Level="1"
             AllowAbsent="no"
             ConfigurableDirectory="APPLICATIONFOLDER">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="DriverFiles" />

      <Feature Id="StartMenu" Title="Start menu shortcut"
               Description="A shortcut in the Start menu." Level="1">
        <ComponentGroupRef Id="StartMenuShortcutFiles" />
        <Level Value="0" Condition="INSTALLSTARTMENUSHORTCUT &lt;&gt; 1" />
      </Feature>

      <Feature Id="Desktop" Title="Desktop shortcut"
               Description="A shortcut on the desktop." Level="1">
        <ComponentGroupRef Id="DesktopShortcutFiles" />
        <Level Value="0" Condition="INSTALLDESKTOPSHORTCUT &lt;&gt; 1" />
      </Feature>
    </Feature>

    <!-- A way out for a deployment that manages the driver itself: msiexec /i ... INSTALLPAWNIO=0
         The app will say what is missing at its first start. -->
    <Property Id="INSTALLPAWNIO" Value="1" Secure="yes" />

    <!-- Deferred, so it runs elevated with no second prompt, and silent. FileRef because a
         deferred action reads no properties and [TempFolder] would arrive empty. -->
    <CustomAction Id="InstallPawnIo"
                  FileRef="PawnIoSetupExe"
                  ExeCommand="-install -silent"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- A running copy holds the exe an upgrade must overwrite. It has no ordinary window and
         runs elevated, so it is asked from the elevated side and then ended. -->
    <util:CloseApplication Id="CloseRunningApp"
                           Target="System-Spinner.exe"
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           TerminateProcess="0"
                           RebootPrompt="no"
                           Timeout="10" />

    <!-- Autostart is a scheduled task the app makes for itself, so the installer knows nothing
         about it: removed here, and a failure is not worth stopping an uninstall over. -->
    <CustomAction Id="RemoveAutostartTask"
                  Directory="APPLICATIONFOLDER"
                  ExeCommand="[System64Folder]schtasks.exe /delete /tn &quot;System-Spinner&quot; /f"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- After the files are on disk, since the setup being run is one of them. Every time:
           what to do with a copy it finds is PawnIO's own setup to decide. -->
      <Custom Action="InstallPawnIo" After="InstallFiles"
              Condition="NOT Installed AND INSTALLPAWNIO = 1" />

      <!-- Only on a real uninstall. An upgrade removes the old version with REMOVE=ALL as well,
           and UPGRADINGPRODUCTCODE is set on exactly that half and on nothing else. -->
      <Custom Action="RemoveAutostartTask" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- The advanced set: the one that asks whom the install is for and brings the folder page. -->
    <ui:WixUI Id="WixUI_Advanced" />
    <WixVariable Id="WixUILicenseRtf" Value="$(License)" />

    <!-- Through the shell, not started directly: the app demands administrator rights, and a
         program started by the installer never gets the prompt for them (error 1631). -->
    <Property Id="LAUNCHAFTERINSTALL" Value="1" />

    <CustomAction Id="SetAppTarget" Property="WixShellExecTarget" Value="[#SystemSpinnerExe]" />
    <CustomAction Id="LaunchApplication" DllEntry="WixShellExec" BinaryRef="Wix4UtilCA_X64" Impersonate="yes" />

    <!-- Our shortcuts page, between the folder page and the last one. The tens in Ordering put
         ours after the stock jumps (one to seven); the later of two next-dialogs decides. -->
    <UI>
      <!-- The stock page clears ALLUSERS for "just me". This puts it back, later in the order
           and therefore last: the package is perMachine whichever folder was chosen. -->
      <Publish Dialog="InstallScopeDlg" Control="Next" Property="ALLUSERS" Value="1" Order="8" />

      <!-- The stock set skips the folder page for a per-user install; that half is claimed here. -->
      <Publish Dialog="InstallScopeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg"
               Condition="WixAppFolder = &quot;WixPerUserFolder&quot;" Order="10" />

      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Order="10" />
      <Publish Dialog="ShortcutsDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" />

      <!-- On an update neither the scope nor the folder is a question, so "Advanced" passes both
           pages. The stock jumps out of the first page are ordered one to three. -->
      <Publish Dialog="AdvancedWelcomeEulaDlg" Control="Advanced" Event="NewDialog"
               Value="ShortcutsDlg" Condition="WIX_UPGRADE_DETECTED" Order="20" />

      <Publish Dialog="ShortcutsDlg" Control="Back" Event="NewDialog"
               Value="AdvancedWelcomeEulaDlg" Condition="WIX_UPGRADE_DETECTED" Order="10" />
      <Publish Dialog="ShortcutsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />

      <!-- Claimed only while installing: during maintenance the last page returns to the
           repair-or-remove page, and a page about shortcuts has nothing to say then. -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg"
               Condition="NOT Installed" Order="10" />

      <!-- Only after a fresh install: the same page ends a repair and an uninstall too. The stock
           event that closes it sits at 999, so both of these run before it. -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="SetAppTarget"
               Condition="LAUNCHAFTERINSTALL = 1 AND NOT Installed" Order="1" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="LAUNCHAFTERINSTALL = 1 AND NOT Installed" Order="2" />
    </UI>
  </Package>
</Wix>
