# The finished exe, and what the compiler leaves next to the sources — build.ps1 clears the
# latter after every run, so these are here for builds started from an IDE.
build/
bin/
obj/

# Visual Studio and Rider leave their own state next to the sources.
.vs/
.idea/
*.user
*.suo

# Files the app itself creates while it runs, next to the exe or in the project root.
config.conf
System-Spinner.log
System-Spinner.log.old
sensors-found.txt
